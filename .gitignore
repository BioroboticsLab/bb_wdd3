# Data & Outputs
data/*
!data/.gitkeep

# Keep outputs directory structure, ignore files
outputs/**/*
!outputs/**/
!outputs/**/.gitkeep

# Large Media Files
*.mp4
*.mov
*.avi
*.mkv

# Models & Checkpoints
ckpt/**/*
!ckpt/
!ckpt/.gitkeep
**/models/
**/checkpoints/
*.ckpt
*.pth
*.pt

# Logs & Tracking
logs/
runs/
tb_logs/
tensorboard/
eval_logs/
*.log
events.out.tfevents.*

# Python
__pycache__/
*.py[cod]
*.pytest_cache/
*.egg-info/
*.eggs/
*.ruff_cache/
venv/
.venv/

# Jupyter
.ipynb_checkpoints/

# Tests (generated assets)
tests/**/*.png
tests/**/*.jpg
tests/**/*.jpeg

# OS / Editor
.DS_Store
.idea/
.vscode/
